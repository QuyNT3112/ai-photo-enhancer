# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor configs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# AI Model Weights (Large Binaries > 100MB - Auto-downloaded or use download_models.py)
models/*.pth
models/*.pt
models/*.bin
models/*.safetensors
models/*.onnx
gfpgan/weights/
!models/.gitkeep

# User Runtime Storage & Temporary Outputs
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep
!outputs/batch/
!outputs/batch/.gitkeep

# Environment variables & Logs
*.log
.env
.env.local
